{
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/devin-gate.mjs",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "edit|write|notebook_edit",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/devin-gate.mjs",
          "timeout": 60
        }
      ]
    }
  ]
}
