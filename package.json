{
  "name": "heven-fun",
  "private": true,
  "version": "1.0.0",
  "description": "HEVEN.FUN — bilingual digital games, subscriptions, and one-time keys storefront",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-sitemap.mjs && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node scripts/run-checks.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "db:push": "node scripts/db-push.mjs",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@databuddy/sdk": "^2.6.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.101.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.446.0",
    "plyr": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.7.3",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "daisyui": "^5.6.6",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  }
}
