VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public site origin used for canonical URLs (defaults to window.location / https://heven.fun)
#using "https://heven.pages.dev/" instead of "heven.fun" because "https://heven.pages.dev/" is for testing the website and when im ready i will deploy the website to "heven.fun"

VITE_SITE_URL=https://heven.pages.dev/
# Optional: resize product images via Supabase Image Transformations (Pro plan).
# 1) Dashboard → Storage → enable Image Transformations
# 2) Uncomment the line below and restart `npm run dev` / redeploy
# VITE_SUPABASE_IMAGE_TRANSFORM=true

# Databuddy public Client ID (= website_id for the Query API). Optional — falls back
# to the built-in HEVEN.FUN id in src/lib/analyticsConsent.ts.
VITE_DATABUDDY_CLIENT_ID=

# ── Server-only secrets (Supabase Edge Function secrets — NEVER Vite/VITE_*) ──
# npx supabase secrets set KEY=value ...
# POLAR_ACCESS_TOKEN=polar_at_…       (polar-checkout)
# POLAR_PRODUCT_ID=uuid               (polar-checkout — placeholder product)
# POLAR_WEBHOOK_SECRET=whsec_…        (polar-webhook)
# POLAR_SERVER=sandbox|production     (polar-checkout)
# SITE_URL=https://heven.fun          (polar-checkout / CORS — required in prod)
# DATABUDDY_API_KEY=dbdy_…            (databuddy-analytics)
# DATABUDDY_WEBSITE_ID=same-as-client-id
# PURGE_CRON_SECRET=…                 (purge-deleted-accounts + cron SQL header;
#                                     never commit the live value — see OPS.md / supabase/cron/)
